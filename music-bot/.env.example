# Required
DISCORD_TOKEN=put-your-bot-token-here

# Message Content Intent (prefix commands like !p).
# Also enable it in Developer Portal > Bot > Privileged Gateway Intents.
MESSAGE_CONTENT=true

# Gapless and watchdog
PRELOAD_SECONDS=12
WATCHDOG_SECONDS=15

# Prefix commands, owner, playlist limit, image card
PREFIX=!
OWNER_ID=
PLAYLIST_LIMIT=10
MUSIC_CARD=true

# Card: seconds between image re-uploads, recap card at session end,
# plays before the "hit" badge, timezone for birthday badges
CARD_REFRESH=20
SESSION_SUMMARY=true
HOT_THRESHOLD=5
TIMEZONE=Asia/Bangkok

# Smooth volume ramp and fades (milliseconds, 0 = off)
VOLUME_RAMP_MS=800

# Same loudness for every track (FFmpeg loudnorm). Servers can change it with /settings normalize
NORMALIZE=true
# NORMALIZE_FILTER=loudnorm=I=-14:LRA=11:TP=-1.5
FADE_MS=400

# Limits
IDLE_TIMEOUT=300
ALONE_TIMEOUT=30
MAX_QUEUE=500
MAX_PER_USER=100
MAX_DURATION=0
PLAY_COOLDOWN=3
DEFAULT_VOLUME=50
PANEL_REFRESH=10

# Storage
DB_PATH=data/musicbot.db

# yt-dlp: timeout per lookup, verbose log for debugging
AUTOCOMPLETE=true
YTDL_TIMEOUT=45
YTDL_DEBUG=false

# Optional: cookies.txt if YouTube says "Sign in to confirm you're not a bot"
# YTDLP_COOKIES=data/cookies.txt

# Optional: Spotify links (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: full path to ffmpeg (auto-detected when empty)
# FFMPEG_PATH=

# Stream mode: auto | pipe | direct (auto picks pipe for the bundled FFmpeg)
STREAM_MODE=auto

# Health endpoint, 0 = off
HEALTH_PORT=8080

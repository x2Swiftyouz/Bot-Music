# Required
DISCORD_TOKEN=put-your-bot-token-here

# Message Content Intent (prefix commands like !p).
# Also enable it in Developer Portal > Bot > Privileged Gateway Intents.
MESSAGE_CONTENT=true

# Gapless and watchdog
PRELOAD_SECONDS=12
WATCHDOG_SECONDS=15

# Prefix commands, owner, playlist limit, image card
PREFIX=!
OWNER_ID=
PLAYLIST_LIMIT=10
MUSIC_CARD=true

# Card: seconds between image re-uploads, recap card at session end,
# plays before the "hit" badge, timezone for birthday badges
CARD_REFRESH=10
# moving equalizer on the card (animated WebP; Discord labels it "GIF"):
# always, start = only the first card of each song, off
CARD_ANIMATION=always
SESSION_SUMMARY=true
HOT_THRESHOLD=5
TIMEZONE=Asia/Bangkok

# Smooth volume ramp and fades (milliseconds, 0 = off)
VOLUME_RAMP_MS=800
FADE_MS=400

# Same loudness for every track (FFmpeg loudnorm). Servers can change it with /settings normalize
NORMALIZE=true
# NORMALIZE_FILTER=loudnorm=I=-14:LRA=11:TP=-1.5

# Limits
IDLE_TIMEOUT=300
ALONE_TIMEOUT=30
MAX_QUEUE=500
MAX_PER_USER=100
MAX_DURATION=0
PLAY_COOLDOWN=3
DEFAULT_VOLUME=50
PANEL_REFRESH=10
LYRICS_REFRESH=3
# look lyrics up when a song starts, so 🎤 / 🎙 show whether there are any
LYRICS_PREFETCH=true
# re-post the panel at the bottom after this many chat messages below it (0 = off)
STICKY_PANEL=10
# songs overlap this many seconds (old fades out, new fades in); 0 = off
CROSSFADE_SECONDS=4
# request channel: seconds before a request message is removed (too fast and some
# Discord apps keep showing it)
REQUEST_DELETE_DELAY=2
# look for a new yt-dlp every N hours; restarts itself when nobody is listening (0 = off)
YTDLP_UPDATE_HOURS=24
# darker card late at night, start-end hour in TIMEZONE
NIGHT_MODE=true
NIGHT_HOURS=22-6

# Storage
DB_PATH=data/musicbot.db

# yt-dlp: timeout per lookup, verbose log for debugging
AUTOCOMPLETE=true
YTDL_TIMEOUT=45
# yt-dlp runs in this many worker processes so lookups never stutter the music (0 = threads)
YTDL_PROCESSES=2
# draw cards in a low-priority worker process so the music never waits for it
CARD_PROCESS=true
# also write the log to this file (rotated at LOG_MAX_MB, LOG_BACKUPS old files kept); empty = off
LOG_FILE=data/logs/bot.log
LOG_MAX_MB=5
LOG_BACKUPS=3
YTDL_DEBUG=false

# Optional: cookies.txt if YouTube says "Sign in to confirm you're not a bot"
# YTDLP_COOKIES=data/cookies.txt

# Optional: Spotify links (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: full path to ffmpeg (auto-detected when empty)
# FFMPEG_PATH=

# Stream mode: auto | pipe | direct (auto picks pipe for the bundled FFmpeg)
STREAM_MODE=auto

# Auto-clean command replies and bot messages (seconds). Per server: /settings autoclean
AUTO_CLEAN=true
AUTO_CLEAN_SECONDS=20

# Message look: groove (Components V2 containers) or classic (embeds)
UI_STYLE=groove

# Health endpoint, 0 = off
HEALTH_PORT=8080
